  <style>
  @keyframes hero-cursor-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  .hero-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: currentColor;
    vertical-align: text-bottom;
    margin-left: 0.05em;
    animation: hero-cursor-blink 0.9s step-end infinite;
  }
  [data-typewriter].typing .hero-cursor {
    animation: none;
    opacity: 1;
  }
  @font-face {
  font-family: 'wf-0bbb5478a388';
  src: url(https://fonts.fontdue.com/british-standard-type/fonts/0390b7f5cab58b1169b990378c8b86df10e864c2.woff2) format('woff2'), url(https://fonts.fontdue.com/british-standard-type/fonts/2a0e8f4519d6c19302458cefeb6246860b09c11f.woff) format('woff');
  font-display: swap;
}

</style>
<script>
  // Header transparency: the marketing top-nav is transparent while the
  // lime hero is still in view, then snaps to its filled state.
  (function() {
    var header = document.getElementById('site-header');
    var hero = document.getElementById('home-hero');
    if (!header || !hero) return;
    var update = function() {
      var b = hero.getBoundingClientRect().bottom;
      header.dataset.transparent = b > 56 ? 'true' : 'false';
    };
    requestAnimationFrame(update);
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update);
  })();

  // Hero font credit: name the picked font only once the browser has
  // loaded it. When every source fails the headline falls back to Tomka,
  // so the credit is removed rather than naming a font that isn't shown.
  // The marquee can declare the same family again, so any one of the
  // matching faces loading counts.
  (function() {
    var credit = document.querySelector('[data-hero-font-credit]');
    if (!credit) return;
    var id = credit.dataset.fontId;
    var faces = [];
    if (document.fonts && document.fonts.forEach) {
      document.fonts.forEach(function(face) {
        if (face.family.replace(/["']/g, '') === id) faces.push(face);
      });
    }
    if (faces.length === 0) { credit.remove(); return; }
    var pending = faces.length;
    faces.forEach(function(face) {
      face.load().then(function() {
        credit.classList.remove('invisible', 'opacity-0');
      }, function() {
        pending--;
        if (pending === 0) credit.remove();
      });
    });
  })();

  // Hero splash: pick line breakdown for the current viewport, rebuild
  // slot DOM, autofit, then run the typewriter. Inline so the cursor is
  // in place before the JS bundle loads. Pick-once — orientation/resize
  // crossing the breakpoint won't re-pick mid-session.
  (function() {
    var tw = document.querySelector('[data-typewriter]');
    if (!tw) return;
    var narrowLines = JSON.parse(tw.dataset.narrowLines || '[]');
    var lines = narrowLines.length && window.matchMedia('(max-width: 640px)').matches
      ? narrowLines
      : JSON.parse(tw.dataset.lines || '[]');
    var h1 = tw.closest('h1');

    // Always rebuild slots so one path handles both tiers; mirrors the
    // server-rendered structure.
    tw.innerHTML = lines.map(function(_, i) {
      return '<span class="block whitespace-nowrap"><span class="relative inline-block">' +
        '<span aria-hidden="true" class="invisible"></span>' +
        '<span class="absolute inset-0 text-left whitespace-nowrap" data-line-slot="' + i + '">' +
          '<span data-line-out="' + i + '"></span>' +
          (i === 0 ? '<span class="hero-cursor" data-cursor aria-hidden="true"></span>' : '') +
        '</span></span></span>';
    }).join('');
    tw.querySelectorAll('.invisible').forEach(function(el, i) {
      el.textContent = lines[i];
    });
    var outs = tw.querySelectorAll('[data-line-out]');
    var slots = tw.querySelectorAll('[data-line-slot]');
    var cursor = tw.querySelector('[data-cursor]');

    var fontReady = Promise.resolve();
    if (h1 && lines.length > 0) {
      var canvas = document.createElement('canvas');
      var ctx = canvas.getContext('2d');
      var REF = 100, MIN = 18;
      var fontFamily = getComputedStyle(h1).fontFamily;
      var fontSpec = '400 ' + REF + 'px ' + fontFamily;
      // Pixel size that makes the widest line fill the column. `cap`
      // clamps the result so a late webfont swap can only ever shrink the
      // headline, never grow it past the box we've already reserved below.
      var measure = function(cap) {
        var parent = h1.parentElement;
        if (!parent || parent.clientWidth <= 0) return 0;
        ctx.font = fontSpec;
        var widest = lines.reduce(function(m, l) {
          return Math.max(m, ctx.measureText(l).width);
        }, 0);
        if (widest <= 0) return 0;
        var px = Math.max(MIN, Math.floor(parent.clientWidth / (widest / REF)));
        return cap ? Math.min(px, cap) : px;
      };
      // Freeze the headline's box once it's sized. Locking width + height
      // means the late font swap (and its re-fit) only changes the glyphs
      // inside the box, never the space the caption and buttons sit below
      // — which is what drove the homepage's field CLS. The shrink-only
      // re-fit lands before the typewriter starts (it shares fontReady),
      // so it happens while just the cursor is visible.
      var sized = 0;
      var fit = function(cap, freeze) {
        var px = measure(cap);
        if (!px) return;
        sized = px;
        h1.style.fontSize = px + 'px';
        if (freeze) {
          h1.style.width = h1.offsetWidth + 'px';
          h1.style.height = h1.offsetHeight + 'px';
        }
      };
      // First pass runs before paint with whatever face is available (the
      // picked webfont if already cached, otherwise the Tomka fallback).
      fit(0, true);
      if (document.fonts && document.fonts.load) {
        // Re-fit once both the picked face and the Tomka fallback have
        // settled. If the picked face fails the headline is set in Tomka,
        // and the first pass may have measured before Tomka itself was
        // ready – re-fitting only on the picked face's success left the
        // headline overflowing the viewport.
        var settle = function(spec) {
          return document.fonts.load(spec).then(null, function() {});
        };
        fontReady = Promise.all([settle(fontSpec), settle('400 ' + REF + 'px Tomka')])
          .then(function() { fit(sized, false); });
      }
      // A real viewport resize is user-initiated (excluded from CLS), so
      // release the frozen box and recompute. Skip the synchronous callback
      // ResizeObserver fires on first observe when we've already sized.
      if (typeof ResizeObserver !== 'undefined' && h1.parentElement) {
        var skipNext = sized > 0;
        new ResizeObserver(function() {
          if (skipNext) { skipNext = false; return; }
          h1.style.width = '';
          h1.style.height = '';
          fit(0, true);
        }).observe(h1.parentElement);
      }
    }

    if (lines.length === 0 || !cursor) return;

    var lineIdx = 0, ch = 0;
    var step = function() {
      var line = lines[lineIdx];
      ch++;
      outs[lineIdx].textContent = line.slice(0, ch);
      var lineDone = ch === line.length;
      if (lineDone) {
        lineIdx++;
        ch = 0;
        if (lineIdx < lines.length) slots[lineIdx].appendChild(cursor);
      }
      if (lineIdx < lines.length) {
        var delay = 12 + Math.random() * 22 + (lineDone ? 40 : 0);
        setTimeout(step, delay);
      } else {
        tw.classList.remove('typing');
        cursor.style.animation = 'hero-cursor-blink 0.9s step-end 2 forwards';
      }
    };
    // Wait for the picked webfont AND a 600ms visual beat before
    // starting; cap at 1500ms so a slow/missing font never blocks.
    var minDelay = new Promise(function(r) { setTimeout(r, 600); });
    var maxDelay = new Promise(function(r) { setTimeout(r, 1500); });
    Promise.race([
      Promise.all([fontReady, minDelay]),
      maxDelay
    ]).then(function() { tw.classList.add('typing'); step(); });
  })();
</script>

</div>
<section class="px-[1lh] pt-0 pb-16">
  <div class="mt-16 mx-auto max-w-[920px] text-center text-[clamp(18px,2.4vw,28px)] leading-[1.35] text-balance [&_p]:m-0">
    
<p>Fontdue powers your foundry website behind the scenes, handling your font catalog, licensing, payments and everything after the sale. Start with our template, or build the site however you want and drop in Fontdue’s components. Customers buy directly from your domain, and the money goes into your Stripe account.</p>

  </div>
  <div class="mt-5 mx-auto max-w-[920px] text-center font-mono text-xs uppercase tracking-[0.06em] text-black/55">
    
<p>Trusted by 100+ foundries since 2018</p>

  </div>
</section>
