  <script>
  (function() {
    var root = document.getElementById('foundry-accordion');
    if (!root) return;
    var items = Array.prototype.slice.call(root.querySelectorAll('[data-acc-item]'));
    var graphics = Array.prototype.slice.call(root.querySelectorAll('[data-acc-graphic]'));
    function activate(idx) {
      items.forEach(function(item, i) {
        var active = i === idx;
        item.dataset.active = active ? 'true' : 'false';
        var body = item.querySelector('[data-acc-body]');
        if (body) body.classList.toggle('hidden', !active);
        var icon = item.querySelector('[data-acc-icon]');
        if (icon) icon.textContent = active ? '−' : '+';
      });
      graphics.forEach(function(g, i) {
        g.dataset.active = i === idx ? 'true' : 'false';
      });
    }
    items.forEach(function(item, i) {
      var btn = item.querySelector('[data-acc-trigger]');
      if (btn) btn.addEventListener('click', function() { activate(i); });
    });
  })();
</script>

</section>
<section class="px-[1lh] pb-20 scroll-mt-4">
  <div class="pt-3.5 font-mono text-xs uppercase tracking-[0.06em] tabular-nums text-black/55 border-t border-black/20">
  Showcase
</div>
