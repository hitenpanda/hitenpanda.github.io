    <span class="w-2.5 h-2.5 rounded-full bg-lime"></span>
    <span class="ml-3 font-mono text-[10px] uppercase tracking-[0.04em] truncate text-white/55">
      yourstore.fontdue.com
    </span>
  </div>
  
